generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  name      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  applications Application[]
  resumes      Resume[]
}

model Company {
  id      String @id @default(uuid())
  name    String
  website String?
  jobs    Job[]
}

model Job {
  id          String    @id @default(uuid())
  title       String
  description String    @db.Text
  location    String?
  remote      Boolean   @default(false)
  salaryMin   Int?
  salaryMax   Int?
  url         String?
  postedAt    DateTime?
  createdAt   DateTime  @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  applications Application[]

  // AI-hoz később: embedding vektor tárolása (pgvector extension szükséges)
  // embedding    Unsupported("vector")?
}

model Application {
  id         String            @id @default(uuid())
  status     ApplicationStatus @default(SAVED)
  appliedAt  DateTime?
  notes      String?           @db.Text
  matchScore Float? // AI matching eredménye (0-1)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  jobId String
  job   Job    @relation(fields: [jobId], references: [id])

  statusHistory StatusHistory[]

  @@unique([userId, jobId]) // egy user egy jobra csak egyszer "applikáljon"
}

model StatusHistory {
  id        String            @id @default(uuid())
  status    ApplicationStatus
  changedAt DateTime          @default(now())

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])
}

model Resume {
  id        String   @id @default(uuid())
  title     String
  content   String   @db.Text
  fileUrl   String?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // AI-hoz később: embedding vektor tárolása
  // embedding Unsupported("vector")?
}

enum ApplicationStatus {
  SAVED
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}